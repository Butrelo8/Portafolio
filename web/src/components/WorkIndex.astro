---
import type { CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import coastPoster from '../assets/shots/coast-merch-3d-poster.webp';

interface Props {
  projects: CollectionEntry<'projects'>[];
  lang: 'en' | 'es';
}

const { projects, lang } = Astro.props;

// Locked-off clip of Coast's live /merch page: the page stays still, only the shirt turns.
const coastPosterImg = await getImage({ src: coastPoster, width: 960, format: 'webp' });
const clips: Record<string, { src: string; poster: string; es: string; en: string }> = {
  'coast-competition': {
    src: '/media/coast-merch-3d.mp4',
    poster: coastPosterImg.src,
    es: 'La playera es un modelo 3D en la página de merch del sitio en vivo, y quien la visita la gira. Hecho con three.js y model-viewer.',
    en: 'The shirt is a 3D model on the live site’s merch page, and the visitor turns it. Built with three.js and model-viewer.',
  },
};

const t =
  lang === 'es'
    ? { live: 'Visitar sitio ↗', play: 'Reproducir', pause: 'Pausa', clip: 'Grabación de la playera de Coast girando en su página de merch, en bucle y sin audio.' }
    : { live: 'Live site ↗', play: 'Play', pause: 'Pause', clip: 'Recording of the Coast shirt turning on its merch page, looping, no audio.' };

const rows = projects.map((p) => {
  const slug = p.id.replace(/^(en|es)\//, '');
  const clip = clips[slug];
  return {
    ...p.data,
    slug,
    href: lang === 'en' ? `/en/projects/${slug}` : `/projects/${slug}`,
    clip: clip && { src: clip.src, poster: clip.poster, caption: clip[lang] },
  };
});
---

<div class="work" data-work>
  <ul class="work__list" role="list">
    {rows.map((r, i) => (
      <li class="work__li">
        <div class="work__shot">
          {r.clip ? (
            <span class="clip" data-clip data-play={t.play} data-pause={t.pause}>
              <video muted autoplay loop playsinline preload="none" poster={r.clip.poster} width="960" height="540" aria-label={t.clip}>
                <source data-src={r.clip.src} type="video/mp4" />
              </video>
              <button class="clip__toggle mono" type="button" hidden>{t.pause}</button>
            </span>
          ) : (
            r.screenshot && <Image src={r.screenshot} alt="" widths={[400, 800]} sizes="100vw" loading="lazy" />
          )}
        </div>
        <a class="work__row" href={r.href} data-work-row={i}>
          <span class="work__name mono">{r.name}</span>
          <span class="work__meta mono">{r.client} · {r.year}</span>
        </a>
      </li>
    ))}
  </ul>

  <div class="work__panel">
    {rows.map((r, i) => (
      <figure class="work__item" data-work-item={i} data-active={i === 0 ? '' : undefined}>
        {r.clip ? (
          <span class="clip" data-clip data-play={t.play} data-pause={t.pause}>
            <video muted autoplay loop playsinline preload="none" poster={r.clip.poster} width="960" height="540" aria-label={t.clip}>
              <source data-src={r.clip.src} type="video/mp4" />
            </video>
            <button class="clip__toggle mono" type="button" hidden>{t.pause}</button>
          </span>
        ) : (
          r.screenshot && (
            <Image src={r.screenshot} alt={`${r.name} — ${r.tagline}`} widths={[640, 1000]} sizes="640px" loading={i === 0 ? 'eager' : 'lazy'} />
          )
        )}
        <figcaption>
          <p class="work__tagline">{r.tagline}</p>
          {r.clip && <p class="work__clipnote">{r.clip.caption}</p>}
          {r.liveUrl && (
            <a class="work__live mono" href={r.liveUrl} target="_blank" rel="noopener noreferrer">{t.live}</a>
          )}
        </figcaption>
      </figure>
    ))}
  </div>
</div>

<script>
  // Wide screens: the panel shows the hovered or focused row's shot. Every figure is
  // rendered on the server, the first one active, so without JS the panel still works.
  for (const work of document.querySelectorAll<HTMLElement>('[data-work]')) {
    const items = work.querySelectorAll<HTMLElement>('[data-work-item]');
    const show = (i: string) => {
      for (const item of items) item.toggleAttribute('data-active', item.dataset.workItem === i);
    };
    for (const row of work.querySelectorAll<HTMLElement>('[data-work-row]')) {
      const i = row.dataset.workRow ?? '0';
      row.addEventListener('pointerenter', () => show(i));
      row.addEventListener('focusin', () => show(i));
    }
  }

  // Same handling as ToolStrip's window: the clip downloads near the viewport (a hidden
  // copy never intersects, so it never loads), waits for play under reduced motion, and
  // the button always pauses it.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const clip of document.querySelectorAll<HTMLElement>('[data-clip]')) {
    const video = clip.querySelector('video');
    const button = clip.querySelector('button');
    if (!video || !button) continue;

    let loaded = false;
    const load = () => {
      if (loaded) return;
      loaded = true;
      for (const s of video.querySelectorAll<HTMLSourceElement>('source[data-src]')) {
        s.src = s.dataset.src ?? '';
      }
      video.load();
    };

    const sync = () => {
      const playing = !video.paused;
      clip.dataset.state = playing ? 'playing' : 'paused';
      button.textContent = playing ? clip.dataset.pause ?? '' : clip.dataset.play ?? '';
    };

    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    button.hidden = false;

    button.addEventListener('click', () => {
      if (!loaded) load();
      if (video.paused) void video.play();
      else video.pause();
    });

    if (reduce) {
      video.removeAttribute('autoplay');
      video.pause();
      sync();
    } else {
      new IntersectionObserver(
        (entries, observer) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          load();
          observer.disconnect();
        },
        { rootMargin: '300px' },
      ).observe(clip);
    }
  }
</script>

<style>
  .work__list { list-style: none; border-bottom: 1px solid var(--color-border); }
  .work__li { position: relative; border-top: 1px solid var(--color-border); padding-top: var(--space-3); }
  /* The whole row is the link; the clip's button sits above the stretched area. */
  .work__row::after { content: ''; position: absolute; inset: 0; }
  .work__row { display: grid; gap: var(--space-1); min-height: 47px; padding-block: var(--space-3); }
  .work__shot { display: block; }
  .work__shot :global(img), .clip video { display: block; width: 100%; aspect-ratio: 16 / 9; height: auto; object-fit: cover; object-position: top center; }
  .work__name { font-size: var(--text-lg); font-weight: 700; }
  .work__meta { font-size: var(--text-xs); color: var(--color-muted); }
  .work__row:hover .work__name, .work__row:focus-visible .work__name { color: var(--color-accent-strong); }
  .work__row:focus-visible::after { outline: 2px solid var(--color-accent-strong); outline-offset: 2px; }

  .work__panel { display: none; }

  @media (min-width: 900px) {
    .work { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: var(--space-12); align-items: start; }
    .work__shot { display: none; }
    .work__li { padding-top: 0; }
    .work__row { grid-template-columns: auto 1fr; align-items: baseline; column-gap: var(--space-6); }
    .work__name { white-space: nowrap; }
    .work__meta { text-align: right; }
    .work__panel { display: block; position: sticky; top: var(--space-8); }
    .work__item:not([data-active]) { display: none; }
    .work__item :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: top center; border: 1px solid var(--color-border); }
    .work__item .clip video { border: 1px solid var(--color-border); }
  }

  .work__item figcaption { margin-top: var(--space-4); display: grid; gap: var(--space-2); }
  .work__tagline { font-size: var(--text-base); color: var(--color-fg-soft); }
  .work__clipnote { font-size: var(--text-sm); color: var(--color-muted); }
  .work__live { justify-self: start; font-size: var(--text-sm); font-weight: 700; color: var(--color-accent-strong); text-decoration: underline; text-underline-offset: 0.2em; min-height: 44px; display: inline-flex; align-items: center; }

  .clip { position: relative; display: block; background: #000; }
  .clip__toggle { position: absolute; z-index: 1; right: var(--space-3); bottom: var(--space-3); min-height: 44px; padding: 0 var(--space-4); background: var(--color-surface); color: var(--color-fg); border: var(--border-width) solid var(--color-border); font-size: var(--text-xs); font-weight: 700; cursor: pointer; }
  .clip__toggle:focus-visible { outline: 2px solid var(--color-accent-strong); outline-offset: 2px; }
  .clip[data-state='paused'] .clip__toggle { inset: 50% auto auto 50%; transform: translate(-50%, -50%); background: var(--color-accent-strong); color: var(--color-surface); box-shadow: var(--shadow-brut-sm); }
</style>
