---
import { getImage } from 'astro:assets';
import poster from '../assets/shots/cc-deck-poster.webp';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;

// Poster at the video's own width, optimised at build like every other shot.
const posterImg = await getImage({ src: poster, width: 1280, format: 'webp' });

// Personal tooling. None of it is published, so these are deliberately link-free —
// they're here as evidence of range, not as products. The lead entry gets the window.
const lead = {
  name: 'cc-deck / mothership',
  stack: 'Bash · tmux · Claude\u00a0Code\u00a0· pi · opencode',
  en: 'I built my own instead of using an existing one: I needed to run many agents at once while the same PC renders 3D scenes, generates video and images and runs local AI models. It lives in the terminal: I drive it over ssh from my Mac or any device. One central session hands work to several Claude Code, pi and opencode agents (that is how I use local and free models), each with its own role, model and git branch. Every agent reports back with a verdict and, at 30% of its context, hands off. That is my screen, sped up 3.5x. Runs on Windows (WSL) and Mac.',
  es: 'Lo armé yo en vez de usar uno ya hecho: necesitaba manejar muchos agentes a la vez mientras la misma PC renderiza escenas 3D, genera video e imágenes y corre modelos de IA locales. Vive en la terminal: lo manejo por ssh desde mi Mac o cualquier dispositivo. Una sesión central reparte trabajo a agentes de Claude Code, pi y opencode (así uso modelos locales y gratuitos), cada uno con su rol, modelo y rama de git. Cada agente regresa con un veredicto y, al llegar al 30% de su contexto, entrega el relevo. Esa es mi pantalla, a 3.5x. Corre en Windows (WSL) y Mac.',
};

const tools = [
  {
    name: 'Life-OS',
    stack: 'React · Node · PostgreSQL · MCP',
    en: 'The board where I run my work and my week: tasks, goals, weekly plan, finances, health and notes. My AI agents write to it through its MCP server; I only read.',
    es: 'El tablero donde llevo mi trabajo y mi semana: pendientes, metas, plan semanal, finanzas, salud y notas. Mis agentes de IA escriben en él por su servidor MCP; yo solo leo.',
  },
  {
    name: 'Sonus + Sotto',
    stack: 'Rust · Swift · whisper.cpp',
    en: 'Voice dictation that runs on the machine itself: no cloud, no account. Sonus on Windows, Sotto on macOS. Hotkey, speak, the text lands at the cursor.',
    es: 'Dictado por voz que corre en la propia máquina: sin nube ni cuenta. Sonus en Windows, Sotto en macOS. Atajo, hablas, el texto aparece en el cursor.',
  },
  {
    name: 'MPAF',
    stack: 'TypeScript · Node',
    en: 'The registry of rules and skills I install in every project, this site included.',
    es: 'El registro de reglas y habilidades que instalo en cada proyecto, este sitio incluido.',
  },
];

const t =
  lang === 'es'
    ? {
        heading: '// herramientas propias',
        blurb:
          'Las armé para mi propio trabajo. No están a la venta; están aquí porque quien automatiza lo suyo sabe cuánto vale automatizar lo tuyo.',
        winTitle: 'cc-deck — mothership',
        videoLabel: 'Grabación de mi pantalla de trabajo con cc-deck, a 3.5x, en bucle y sin audio.',
        play: 'Reproducir',
        pause: 'Pausa',
      }
    : {
        heading: '// my own tools',
        blurb:
          'Built for my own work. Not for sale — here because someone who automates their own job knows what automating yours is worth.',
        winTitle: 'cc-deck — mothership',
        videoLabel: 'Recording of my work screen running cc-deck, at 3.5x, looping, no audio.',
        play: 'Play',
        pause: 'Pause',
      };
---

<section class="section container">
  <h2 class="section__title mono">{t.heading}</h2>
  <p class="tools__blurb">{t.blurb}</p>

  <div class="lead">
    <div class="tools__item">
      <h3 class="tools__name mono">{lead.name}</h3>
      <p class="tools__stack mono">{lead.stack}</p>
      <p class="tools__desc">{lang === 'es' ? lead.es : lead.en}</p>
    </div>

    <div class="win" data-tool-win data-state="idle" data-play={t.play} data-pause={t.pause}>
      <div class="win__bar" aria-hidden="true">
        <span class="win__dot win__dot--close"></span>
        <span class="win__dot win__dot--min"></span>
        <span class="win__dot win__dot--zoom"></span>
        <span class="win__title mono">{t.winTitle}</span>
      </div>
      <div class="win__screen">
        <video
          muted
          autoplay
          loop
          playsinline
          preload="metadata"
          poster={posterImg.src}
          width="1280"
          height="696"
          aria-label={t.videoLabel}
        >
          <source data-src="/media/cc-deck-3-5x.webm" type="video/webm" />
          <source data-src="/media/cc-deck-3-5x.mp4" type="video/mp4" />
        </video>
        <button class="win__toggle mono" type="button" hidden>{t.pause}</button>
      </div>
    </div>
  </div>

  <ul class="tools" role="list">
    {tools.map((tool) => (
      <li class="tools__item">
        <h3 class="tools__name mono">{tool.name}</h3>
        <p class="tools__stack mono">{tool.stack}</p>
        <p class="tools__desc">{lang === 'es' ? tool.es : tool.en}</p>
      </li>
    ))}
  </ul>
</section>

<script>
  // The clip downloads only when the window is near the viewport. Under
  // prefers-reduced-motion it waits for the visitor to press play. The button
  // doubles as the pause control, so the loop can always be stopped.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const win of document.querySelectorAll<HTMLElement>('[data-tool-win]')) {
    const video = win.querySelector('video');
    const button = win.querySelector('button');
    if (!video || !button) continue;

    let loaded = false;
    const load = () => {
      if (loaded) return;
      loaded = true;
      for (const s of video.querySelectorAll<HTMLSourceElement>('source[data-src]')) {
        s.src = s.dataset.src ?? '';
      }
      video.load();
    };

    const sync = () => {
      const playing = !video.paused;
      win.dataset.state = playing ? 'playing' : 'paused';
      button.textContent = playing ? win.dataset.pause ?? '' : win.dataset.play ?? '';
    };

    video.addEventListener('play', sync);
    video.addEventListener('pause', sync);
    button.hidden = false;

    button.addEventListener('click', () => {
      if (!loaded) load();
      if (video.paused) void video.play();
      else video.pause();
    });

    if (reduce) {
      video.removeAttribute('autoplay');
      video.pause();
      sync();
    } else {
      new IntersectionObserver(
        (entries, observer) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          load();
          observer.disconnect();
        },
        { rootMargin: '300px' },
      ).observe(win);
    }
  }
</script>

<style>
  .section { padding-block: var(--space-16); }
  .section__title { font-size: var(--text-xl); font-weight: 700; margin-bottom: var(--space-4); color: var(--color-muted); }
  .tools__blurb { color: var(--color-muted); max-width: 60ch; margin-bottom: var(--space-8); font-size: var(--text-sm); }

  .lead { display: grid; gap: var(--space-8); align-items: center; margin-bottom: var(--space-12); }
  @media (min-width: 900px) {
    .lead { grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr); gap: var(--space-12); }
  }

  .tools { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--space-6); list-style: none; }
  .tools__item { border-left: var(--border-width-thick) solid var(--color-border); padding-left: var(--space-4); }
  .tools__name { font-size: var(--text-lg); font-weight: 700; margin-bottom: var(--space-1); }
  .tools__stack { font-size: var(--text-xs); color: var(--color-accent-strong); margin-bottom: var(--space-3); text-wrap: balance; }
  .tools__desc { font-size: var(--text-sm); color: var(--color-muted); line-height: 1.6; }

  /* macOS-style window: traffic lights, title bar, rounded corners, soft shadow. */
  .win { min-width: 0; border: var(--border-width) solid var(--color-border); border-radius: 12px; overflow: hidden; background: var(--color-fg); box-shadow: 0 24px 48px -16px rgb(26 26 26 / 0.4); }
  .win__bar { position: relative; display: flex; align-items: center; gap: 8px; height: 2.25rem; padding-inline: var(--space-3); background: var(--color-fg); border-bottom: 1px solid rgb(245 240 232 / 0.16); }
  .win__dot { width: 12px; height: 12px; border-radius: 50%; flex: none; }
  .win__dot--close { background: #ff5f57; }
  .win__dot--min { background: #febc2e; }
  .win__dot--zoom { background: #28c840; }
  .win__title { position: absolute; inset-inline: 0; text-align: center; font-size: var(--text-xs); color: rgb(245 240 232 / 0.7); pointer-events: none; }
  .win__screen { position: relative; aspect-ratio: 1280 / 696; background: #000; }
  .win__screen video { display: block; width: 100%; height: 100%; object-fit: cover; }

  .win__toggle { position: absolute; right: var(--space-3); bottom: var(--space-3); min-height: 44px; padding: 0 var(--space-4); background: var(--color-surface); color: var(--color-fg); border: var(--border-width) solid var(--color-border); font-size: var(--text-xs); font-weight: 700; cursor: pointer; }
  .win__toggle:focus-visible { outline: 2px solid var(--color-accent-strong); outline-offset: 2px; }
  .win[data-state='paused'] .win__toggle { inset: 50% auto auto 50%; transform: translate(-50%, -50%); background: var(--color-accent-strong); color: var(--color-surface); box-shadow: var(--shadow-brut-sm); }
</style>
