---
interface Props {
  lang: 'en' | 'es'
  currentPath: string
}

const { lang, currentPath } = Astro.props
const otherLang = lang === 'en' ? 'es' : 'en'
// Spanish lives at the root; English is prefixed with /en. Most paths are identical either side of
// that prefix; these are the ones whose slug differs and would 404 on a plain prefix swap.
const slugPairs: Record<string, string> = { '/gracias': '/thanks' }
const swapSlug = (path: string, pairs: Record<string, string>) => {
  const trimmed = path.replace(/\/$/, '')
  const match = pairs[trimmed]
  return match ? `${match}/` : path
}
const otherPath =
  lang === 'es'
    ? `/en${swapSlug(currentPath, slugPairs)}`
    : swapSlug(currentPath.replace(/^\/en/, '') || '/', Object.fromEntries(
        Object.entries(slugPairs).map(([es, en]) => [en, es]),
      ))

const links = lang === 'en'
  ? [
      { href: '/en/', label: 'Work' },
      { href: '/en/about', label: 'About' },
      { href: '/en/#contact', label: 'Contact' },
    ]
  : [
      { href: '/', label: 'Trabajo' },
      { href: '/about', label: 'Sobre mí' },
      { href: '/#contact', label: 'Contacto' },
    ]
---

<nav class="nav" aria-label="Main navigation">
  <div class="container nav__inner">
    <a href={lang === 'en' ? '/en/' : '/'} class="nav__brand mono">Ivan Aguirre</a>
    <ul class="nav__links" role="list">
      {links.map(l => <li><a href={l.href} class="nav__link mono">{l.label}</a></li>)}
    </ul>
    <a href={otherPath} class="nav__lang mono" aria-label={`Switch to ${otherLang}`}>
      {otherLang.toUpperCase()}
    </a>
  </div>
</nav>

<style>
  .nav { border-bottom: var(--border-width-thick) solid var(--color-border); background: var(--color-bg); position: sticky; top: 0; z-index: 100; }
  /* wrap, or the brand + links + lang chip overflow the viewport below ~430px */
  .nav__inner { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-8); padding-block: var(--space-4); }
  .nav__brand { font-size: var(--text-lg); font-weight: 700; color: var(--color-accent); margin-right: auto; }
  .nav__links { display: flex; gap: var(--space-6); list-style: none; }
  .nav__link { font-size: var(--text-sm); font-weight: 600; transition: color var(--duration-fast); }
  .nav__link:hover { color: var(--color-accent); }
  .nav__lang { padding: var(--space-1) var(--space-3); border: var(--border-width) solid var(--color-border); font-size: var(--text-xs); font-weight: 700; transition: background var(--duration-fast), color var(--duration-fast); }
  .nav__lang:hover { background: var(--color-fg); color: var(--color-bg); }
</style>
