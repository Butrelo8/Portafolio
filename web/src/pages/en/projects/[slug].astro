---
export const prerender = true;
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => p.id.startsWith('en/'));
  return projects.map((project) => ({
    params: { slug: project.slug.replace(/^en\//, '') },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { name, client, year, tagline, summary, liveUrl, repoUrl, screenshot, demo, demoCaption, testimonial } =
  project.data;

// The poster frame reuses the case study screenshot, run through astro:assets so the video does
// not pull a multi-MB PNG before anyone presses play.
const poster = demo && screenshot ? await getImage({ src: screenshot, width: 1440, format: 'webp' }) : undefined;
const { Content } = await project.render();
---

<BaseLayout title={`${name} — ${client}`} description={summary} lang="en">
  <article class="project container">
    <header>
      <p class="mono project__back"><a href="/en/">← Back</a></p>
      <h1 class="project__name mono">{name}</h1>
      <p class="project__tagline">{tagline}</p>
      <div class="project__meta mono">
        <span>{client}</span>
        <span>{year}</span>
      </div>
      <div class="project__links">
        {liveUrl && (
          <a href={liveUrl} target="_blank" rel="noopener noreferrer" class="brut-btn">Live site ↗</a>
        )}
        {repoUrl && (
          <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="brut-btn brut-btn--secondary">Source ↗</a>
        )}
      </div>
    </header>

    {demo ? (
      <figure class="project__demo brut-card">
        <video
          src={demo}
          poster={poster?.src}
          controls
          muted
          loop
          playsinline
          preload="none"
          aria-label={`${name} — ${tagline}`}
        ></video>
        {demoCaption && <figcaption class="mono">{demoCaption}</figcaption>}
      </figure>
    ) : screenshot ? (
      <div class="project__screenshot brut-card">
        <Image src={screenshot} alt={`${name} — ${tagline}`} widths={[800, 1440]} sizes="(max-width: 900px) 100vw, 900px" />
      </div>
    ) : null}

    <div class="project__body prose">
      <Content />
    </div>

    {testimonial && (
      <figure class="project__quote brut-card">
        <blockquote>{testimonial.quote}</blockquote>
        <figcaption class="mono">
          {testimonial.author} — <span>{testimonial.role}</span>
        </figcaption>
      </figure>
    )}

    <aside class="project__cta brut-card">
      <p>Need something like this for your business?</p>
      <a href="/en/#contact" class="brut-btn">Tell me what you need</a>
    </aside>
  </article>
</BaseLayout>

<style>
  .project { padding-block: var(--space-12); }
  .project__back { margin-bottom: var(--space-6); font-size: var(--text-sm); }
  .project__back a:hover { color: var(--color-accent); }
  .project__name { font-size: var(--text-2xl); font-weight: 700; margin-bottom: var(--space-3); }
  .project__tagline { font-size: var(--text-lg); color: var(--color-accent); font-weight: 600; margin-bottom: var(--space-4); max-width: 40ch; }
  .project__meta { display: flex; gap: var(--space-6); font-size: var(--text-sm); color: var(--color-muted); margin-bottom: var(--space-4); }
  .project__links { display: flex; gap: var(--space-4); flex-wrap: wrap; margin-bottom: var(--space-8); }
  .project__screenshot { margin-bottom: var(--space-8); overflow: hidden; }
  .project__screenshot :global(img) { display: block; width: 100%; height: auto; }
  .project__demo { margin-bottom: var(--space-8); overflow: hidden; }
  .project__demo video { display: block; width: 100%; height: auto; background: var(--color-fg); }
  .project__demo figcaption { padding: var(--space-3) var(--space-4); font-size: var(--text-xs); color: var(--color-muted); border-top: var(--border-width) solid var(--color-border); }
  .project__cta { margin-top: var(--space-12); padding: var(--space-8); text-align: center; }
  .project__cta p { font-size: var(--text-lg); margin-bottom: var(--space-6); }
  .project__body { max-width: 70ch; }
  .project__quote { margin-top: var(--space-12); padding: var(--space-8); max-width: 70ch; }
  .project__quote blockquote { font-size: var(--text-lg); line-height: 1.6; margin-bottom: var(--space-4); }
  .project__quote figcaption { font-size: var(--text-sm); color: var(--color-muted); }
  .brut-btn--secondary { background: var(--color-surface); color: var(--color-fg); }
  .prose :global(h2) { font-family: var(--font-mono); margin-block: var(--space-8) var(--space-3); font-size: var(--text-xl); }
  .prose :global(p) { margin-bottom: var(--space-4); line-height: 1.7; }
  .prose :global(a) { color: var(--color-accent); text-decoration: underline; }
</style>
