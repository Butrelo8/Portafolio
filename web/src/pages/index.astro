---
export const prerender = true;
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ToolStrip from '../components/ToolStrip.astro';
import ContactForm from '../components/ContactForm.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = (await getCollection('projects', (p) => p.id.startsWith('es/'))).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Ivan — Desarrollador web en Veracruz"
  description="Hago plataformas de reservas, sitios de eventos y herramientas internas para negocios en Veracruz."
  lang="es"
>
  <section class="hero container">
    <p class="hero__label mono">Veracruz, México</p>
    <h1 class="hero__title">
      Hago sitios web<br />
      <span class="hero__accent">que trabajan.</span>
    </h1>
    <p class="hero__sub">
      Plataformas de reservas, sitios de eventos y herramientas internas para negocios reales. No
      folletos. Cuatro funcionando hoy.
    </p>
    <div class="hero__cta">
      <a href="#contact" class="brut-btn">Empezar un proyecto</a>
    </div>
  </section>

  <section class="section container">
    <h2 class="section__title mono">// trabajo seleccionado</h2>
    <div class="grid">
      {projects.map((p) => <ProjectCard project={p} lang="es" />)}
    </div>
  </section>

  <ToolStrip lang="es" />
  <ContactForm lang="es" />
</BaseLayout>

<style>
  .hero { padding-top: var(--space-section); padding-bottom: var(--space-16); }
  .hero__label { font-size: var(--text-sm); color: var(--color-accent); font-weight: 700; margin-bottom: var(--space-4); text-transform: uppercase; letter-spacing: 0.1em; }
  .hero__title { font-family: var(--font-mono); font-size: var(--text-hero); font-weight: 700; line-height: 1.05; margin-bottom: var(--space-6); }
  .hero__accent { color: var(--color-accent); -webkit-text-stroke: 2px var(--color-fg); }
  .hero__sub { font-size: var(--text-lg); color: var(--color-muted); max-width: 52ch; }
  .hero__cta { margin-top: var(--space-8); }
  .section { padding-block: var(--space-16); }
  .section__title { font-size: var(--text-xl); font-weight: 700; margin-bottom: var(--space-8); color: var(--color-muted); }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); gap: var(--space-6); }
</style>
